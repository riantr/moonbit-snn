// analysis/ — spike-train statistics and time-series measures.
//
// Sits on core only. These read recorded spike trains and return numbers:
// rates, ISIs, autocorrelation, population balance, weight change. Nothing
// here simulates or trains anything, so nothing above is needed.
//
// The neuron models *do* reference this package -- an analysis_* function
// reads a neuron's recorded output -- but that is the consumer direction, so
// the two can stay separate.
//
// synapse/ is imported by `analysis_weight.mbt` alone, which measures how much
// a connection's weight changed over a window. That measurement is defined on
// a `SpikingSynapse`, so it cannot be written without naming the type.
import {
  "moonbitlang/core/math",
  "riantr/snn_mbt/core",
  "riantr/snn_mbt/synapse",
}
